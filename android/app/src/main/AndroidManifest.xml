<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- dsh 的语音输入走 getUserMedia + MediaRecorder（不是 WebView 不支持的 Web Speech API），
         所以只要放行就能用。WebView 的权限请求还必须由 onPermissionRequest 显式 grant ——
         不实现它，WebView 默认一律拒绝，那颗麦克风按钮就是死的。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 语音输入的音频设备选择要用到它（Chromium 的 audio_manager 会去选通信设备）。 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 隧道保活：没有前台服务时 App 是 cached 进程，会被冻结（连 dbclient 子进程一起）
         并在内存压力下被优先杀掉。见 TunnelService 的类注释。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 「任务完成时提醒我」（Notifier）：Android 13+ 的运行时权限，只在用户打开那个
         开关时才请求（连接屏「通知」卡）。不申请它的话，通知发出去也不会显示。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".DshApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="DSH Handheld"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshHandheld"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <!-- 这里原先写 android:extractNativeLibs="true"。AGP 9 起在 manifest 里**显式**写这个
             属性会直接构建失败，要求改到 build 脚本里表达（语义不变，AGP 会自己把该属性写进
             合并后的 manifest）。对应 app/build.gradle.kts 的 android.packaging.jniLibs 块。

             它必须保持为 true：dbclient / dropbearkey 是以子进程方式执行的，
             DshApp.onCreate 要从 applicationInfo.nativeLibraryDir 取 libdbclient.so 的绝对
             路径（且要求 it.exists()）。useLegacyPackaging=false 时原生库不再解包到文件系统，
             那个路径不存在 → binPath 为 null → 隧道直接起不来。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- 隧道保活。specialUse：端口转发不属预置类型（dataSync 在 Android 15+ 还有
             每日时长上限，不适合长会话），故走 catch-all 并写明用途。 -->
        <service
            android:name=".TunnelService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="保持到用户电脑的 SSH 隧道，使用户离开应用后仍能继续使用 dsh" />
        </service>

    </application>

</manifest>
