<?xml version="1.0" encoding="utf-8"?>
<!--
  原生客户端：不依赖 Material Components / AppCompat 库，直接用平台内置主题。
  - Theme.Material（API 21+，minSdk 26 满足）深色基底，避免冷启动白闪。
  - 全 App 黑白色调与启动图标一致；状态栏/导航栏区域由 Activity 设为透明并沉浸隐藏。
-->
<resources>
    <style name="Theme.DshHandheld" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#0A0A0E</item>
        <item name="android:navigationBarColor">#0A0A0E</item>
        <item name="android:windowBackground">#0A0A0E</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- 平台控件的选中色。Theme.Material 默认是青绿，而全 App 是黑白色调 ——
             连接屏那个「任务完成时提醒我」开关打开后会是一块青绿，与设计语言打架。
             压回白色；其余控件（分段、单选）有自己的 drawable，不受影响。 -->
        <item name="android:colorAccent">#F5F5F7</item>
        <item name="android:colorControlActivated">#F5F5F7</item>
    </style>
</resources>
